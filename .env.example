# Google Cloud & Vertex AI Configuration (copy to .env for local dev; use Secret Manager in production)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=false

# Local dev API key (in production, fetched automatically from Google Cloud Secret Manager)
GOOGLE_API_KEY=
GEMINI_API_KEY_SECRET_ID=meal-planner-gemini-api-key
GROCERY_PARTNER_API_SECRET_ID=meal-planner-grocery-partner-key

# Model Routing Configuration
FAST_MODEL_NAME=gemini-2.5-flash
REASONING_MODEL_NAME=gemini-2.5-pro

# Persistence & Memory Backend
SESSION_DB_PATH=data/meal_planner_sessions.db
MEMORY_DB_PATH=data/meal_planner_memory.db
VERTEX_AI_SEARCH_DATASTORE_ID=
VERTEX_AI_MEMORY_BANK_ENGINE_ID=

# Context Compaction & Caching
COMPACTION_INTERVAL=6
COMPACTION_OVERLAP_SIZE=2
COMPACTION_TOKEN_THRESHOLD=8000
COMPACTION_EVENT_RETENTION_SIZE=4
CONTEXT_CACHE_TTL_SECONDS=1800

# Guardrails & Human-in-the-Loop
HITL_ORDER_APPROVAL_THRESHOLD_USD=0.01
MAX_WEEKLY_GROCERY_BUDGET_USD=500.00
ENABLE_CLOUD_DLP_REDACTION=false

# Observability & OpenTelemetry
LOG_LEVEL=INFO
OTEL_SERVICE_NAME=meal-planning-concierge-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
ENABLE_CLOUD_TRACE=false
